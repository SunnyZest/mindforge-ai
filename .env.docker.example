# ==============================================================================
# MindForge AI Docker Compose 环境变量示例
#
# 使用方式：复制为 .env 并填入真实值（.env 已在 .gitignore 里，不会被提交）
#   PowerShell: Copy-Item .env.docker.example .env
#   Git Bash:   cp .env.docker.example .env
#
# ★ 生成密钥（不要复用开发环境的、更不要用这里的示例值）：
#   openssl rand -base64 32        # JWT_SECRET / AI_CONFIG_SECRET_KEY
#   openssl rand -base64 24        # SERVICE_TOKEN
#
# ⚠️ 本文件里所有值都是【占位符】。docker-compose.yml 用 ${VAR:?} 校验，
#    忘了填会在启动时立刻报错并指出缺哪个变量 —— 这是刻意的，
#    好过带着一个默认密码静默跑起来。
# ==============================================================================

# ----------------- 数据库 -----------------
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=mindforge
MYSQL_USER=mindforge
MYSQL_PASSWORD=change_me_db
# 只绑 127.0.0.1，供宿主机调试；生产可整段注释掉 compose 里的 ports
MYSQL_PORT=3306

# ----------------- Redis -----------------
REDIS_PASSWORD=change_me_redis
# 宿主机 6379 被本机 Redis 占用时改成 6380
REDIS_PORT=6379

# ----------------- MinIO（Java 侧暂未接入，见 ROADMAP 第七节）-----------------
MINIO_ROOT_USER=change_me_minio
MINIO_ROOT_PASSWORD=change_me_minio_secret
MINIO_CONSOLE_PORT=9001

# ----------------- 文件存储（当前走阿里云 OSS，四项都必填）-----------------
# 用专门的 RAM 子账号 AK，不要用主账号；bucket 保持【私有】，
# 读取由后端签预签名 URL，不要开公共读。
MINDFORGE_OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com
MINDFORGE_OSS_BUCKET=change_me_bucket
MINDFORGE_OSS_ACCESS_KEY_ID=change_me_ak
MINDFORGE_OSS_ACCESS_KEY_SECRET=change_me_sk

# ----------------- 服务间通行令牌 -----------------
# Java 与 Python 必须完全一致（openssl rand -base64 24）
SERVICE_TOKEN=change_me_service_token

# ----------------- 安全加密密钥 -----------------
# JWT 签名密钥（openssl rand -base64 32）
JWT_SECRET=change_me_jwt_secret
# AI 模型 API Key 的加密密钥（openssl rand -base64 32）
# ⚠️ 生产库里的密文要用这个密钥加密录入；换密钥会导致旧密文解不开
AI_CONFIG_SECRET_KEY=change_me_ai_config_key

# ----------------- 大模型服务 -----------------
# 阿里云百炼 / DashScope API Key（必填）
DASHSCOPE_API_KEY=change_me_dashscope_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=deepseek-v4-flash
EMBEDDING_MODEL=text-embedding-v1

# ----------------- 前端打包产物路径（Nginx 挂载用，必填）-----------------
# 在各自仓库 build 后指向 dist 目录。compose 文件在 Java 仓库，
# 而本机三个仓库是平级目录、不在一起，所以要写【绝对路径】：
#   D:/java_IDEA/maven_code/mindforge-ai        ← compose 所在（Java）
#   D:/pythoncode/mindforge-ai-service          ← Python
#   D:/Vue/mindforge                            ← 前端
USER_DIST_PATH=D:/Vue/mindforge/apps/user/dist
ADMIN_DIST_PATH=D:/Vue/mindforge/apps/admin/dist

# ----------------- Python 服务源码路径（构建 ai-service 镜像用）-----------------
# 默认 ../mindforge-ai-service 只在「三个仓库平级」时成立，本机要写绝对路径
AI_SERVICE_PATH=D:/pythoncode/mindforge-ai-service

# ----------------- JVM 参数（可选，默认 -Xms256m -Xmx512m）-----------------
# JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -Duser.timezone=Asia/Shanghai
