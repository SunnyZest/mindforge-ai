<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 日志目录（相对于应用启动目录） -->
    <property name="LOG_HOME" value="./logs"/>

    <!--
      日志格式。%X{traceId:-} 从 MDC 取链路 id，取不到则留空
      （启动阶段还没进 TraceIdFilter，不会有 traceId）
    -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{traceId:-}] [%thread] %logger{36} - %msg%n"/>

    <!--
      控制台。
      charset 不能写死 UTF-8：JDK 18 起 file.encoding 固定是 UTF-8（JEP 400），
      但 Windows cmd 的代码页默认还是 936（GBK），JVM 把这件事如实报在
      stdout.encoding 里。Logback 若按 UTF-8 编码再往控制台写，cmd 会按 GBK
      解码这些字节，中文就成了乱码 —— 配置没错、代码也没错，纯粹是两端编码不一致。
      跟随 stdout.encoding 就自适应了：cmd 下是 GBK，chcp 65001 之后是 UTF-8，
      Linux / IDEA 控制台是 UTF-8。JDK 19 以下没有该属性则退回 UTF-8（行为同从前）。
      要强制指定：-DMF_CONSOLE_CHARSET=GBK 或同名环境变量。
      文件 appender 不受此影响，始终 UTF-8。
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>${MF_CONSOLE_CHARSET:-${stdout.encoding:-UTF-8}}</charset>
        </encoder>
    </appender>

    <!-- 全量日志：按天 + 按大小滚动 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/mindforge-ai.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/mindforge-ai.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>15</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 只收 ERROR，出问题时先看这个文件 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/mindforge-ai-error.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/mindforge-ai-error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 开发环境：控制台 + 文件，业务包 DEBUG -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
        <logger name="com.zest.mindforgeai" level="DEBUG"/>
    </springProfile>

    <!-- 生产环境：只写文件，业务包 INFO -->
    <springProfile name="!dev">
        <root level="INFO">
            <appender-ref ref="FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
        <logger name="com.zest.mindforgeai" level="INFO"/>
    </springProfile>

</configuration>
