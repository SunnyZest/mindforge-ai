<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zest.mindforgeai.mapper.RoleMapper">

    <!--
      查询用户拥有的角色 code 列表：用户 → 角色

      注意：
      1. 表之间没有外键，关联全部写在 SQL 里
      2. 自定义 SQL 不经过 MyBatis-Plus 的逻辑删除，sys_role 的 deleted 需手动过滤
    -->
    <select id="selectCodesByUserId" resultType="java.lang.String">
        SELECT r.code
        FROM sys_user_role ur
        JOIN sys_role r ON r.id = ur.role_id
        WHERE ur.user_id = #{userId}
          AND r.status = 1
          AND r.deleted = 0
    </select>

    <!--
      唯一性检查：统计同 code 的角色数，【故意不过滤 deleted】

      原因：sys_role 上有 uk_role_code 唯一索引，数据库唯一约束不管逻辑删除 ——
      逻辑删除过的角色仍然占着那个 code。所以「角色 code 永久占用」是既定规则，
      检查时必须把已删除的角色也算上，才能给出准确提示。
    -->
    <select id="countByCodeIgnoreDeleted" resultType="int">
        SELECT COUNT(*)
        FROM sys_role
        WHERE code = #{code}
    </select>

</mapper>
