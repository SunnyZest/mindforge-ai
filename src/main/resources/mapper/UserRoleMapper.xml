<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zest.mindforgeai.mapper.UserRoleMapper">

    <!--
      批量查询多个用户的角色 code：用户 → 角色

      用途：管理端用户列表页，一次查出整页用户的角色，避免逐行查询造成 N+1。

      注意：
      1. 表之间没有外键，关联全部写在 SQL 里
      2. 自定义 SQL 不经过 MyBatis-Plus 的逻辑删除，sys_role 的 deleted 需手动过滤
      3. 调用方必须保证 userIds 非空，否则会生成非法的 IN ()
    -->
    <select id="selectRoleCodesByUserIds" resultType="com.zest.mindforgeai.pojo.vo.UserRoleItemVO">
        SELECT ur.user_id AS userId,
               r.code     AS roleCode
        FROM sys_user_role ur
        JOIN sys_role r ON r.id = ur.role_id
                       AND r.status = 1
                       AND r.deleted = 0
        WHERE ur.user_id IN
        <foreach collection="userIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!--
      单个用户的角色明细（管理端用户详情）

      ⚠️ 和上面那条一样：没有外键，关联写在 SQL 里；
         自定义 SQL 不经过 MP 的逻辑删除，sys_role 的 deleted / status 需手动过滤。
         过滤 status = 1 是与权限码口径保持一致 —— 停用的角色不该出现在「他有什么角色」里。
    -->
    <select id="selectRolesByUserId" resultType="com.zest.mindforgeai.pojo.vo.AdminUserRoleVO">
        SELECT r.id   AS roleId,
               r.code AS roleCode,
               r.name AS roleName
        FROM sys_user_role ur
        JOIN sys_role r ON r.id = ur.role_id
                       AND r.status = 1
                       AND r.deleted = 0
        WHERE ur.user_id = #{userId}
        ORDER BY r.id
    </select>

</mapper>
