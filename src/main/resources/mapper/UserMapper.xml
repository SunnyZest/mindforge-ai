<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zest.mindforgeai.mapper.UserMapper">

    <!--
      唯一性检查：统计同名用户数，【故意不过滤 deleted】

      原因：user 表上有 uk_user_username / uk_user_email 唯一索引，
      数据库的唯一约束不管逻辑删除 —— 逻辑删除过的记录仍然占着那个值。
      所以「用户名 / 邮箱永久占用」是本项目的既定规则，
      检查时必须把已删除的记录也算上，才能给出准确提示（而不是撞索引后走兜底）。
    -->
    <select id="countByUsernameIgnoreDeleted" resultType="int">
        SELECT COUNT(*)
        FROM user
        WHERE username = #{username}
    </select>

    <select id="countByEmailIgnoreDeleted" resultType="int">
        SELECT COUNT(*)
        FROM user
        WHERE email = #{email}
    </select>

    <!--
      找回密码用：只数【活跃】账号（deleted = 0）。

      和 countByEmailIgnoreDeleted 分开的原因：邮箱永久占用，
      但已注销的账号不能被找回 —— 所以「有没有注册」只该数现在还活着的。
    -->
    <select id="countByEmailActive" resultType="int">
        SELECT COUNT(*)
        FROM user
        WHERE email = #{email}
          AND deleted = 0
    </select>

    <!--
      手机号唯一性：只统计【活跃】用户（deleted = 0）

      ⚠️ 和上面两个查询的口径刻意不同：
        用户名 / 邮箱永久占用（注销后也不能再用，防冒名）；
        手机号则允许在账号注销后被别人使用 —— 号码是运营商资源，
        长期占用会坑到新机主。数据库侧由函数唯一索引 uk_user_phone 兜底：
            UNIQUE (CASE WHEN deleted = 0 THEN phone ELSE NULL END)
        已删除的行在索引里是 NULL，NULL 不参与唯一性，所以这里也必须只算活跃的。
    -->
    <select id="countByPhoneActive" resultType="int">
        SELECT COUNT(*)
        FROM user
        WHERE phone = #{phone}
          AND deleted = 0
        <if test="excludeUserId != null">
            AND id != #{excludeUserId}
        </if>
    </select>

    <!--
      单个用户的资源占用统计（管理端用户详情）

      为什么用「一条 SQL 六个子查询」而不是在 Java 里分别 count 五张表：
        详情页只查一个人，一条 SQL 就是一次往返；分开写是 6 次。
        子查询都走各自表的 user_id 索引，单用户下代价可以忽略。

      ⚠️ 口径统一 deleted = 0：回收站里的不算占用。
         想算「含回收站」的话不要改这里，另开一个方法 —— 混在一起会让
         「用户说文件删了但占用没降」这类问题变得无法解释。

      ⚠️ COALESCE(SUM(...), 0)：没有文件时 SUM 返回 NULL，
         直接映射到 Long 会是 null，前端要额外判空。
    -->
    <select id="selectResourceStats" resultType="com.zest.mindforgeai.pojo.vo.UserResourceStatsVO">
        SELECT
            (SELECT COUNT(*) FROM knowledge_base
              WHERE user_id = #{userId} AND deleted = 0)                AS knowledgeBaseCount,
            (SELECT COUNT(*) FROM document
              WHERE user_id = #{userId} AND deleted = 0)                AS documentCount,
            (SELECT COUNT(*) FROM resume
              WHERE user_id = #{userId} AND deleted = 0)                AS resumeCount,
            (SELECT COUNT(*) FROM interview
              WHERE user_id = #{userId} AND deleted = 0)                AS interviewCount,
            (SELECT COUNT(*) FROM job
              WHERE user_id = #{userId} AND deleted = 0)                AS jobCount,
            (SELECT COALESCE(SUM(file_size), 0) FROM sys_file
              WHERE user_id = #{userId} AND deleted = 0)                AS storageBytes
    </select>

</mapper>
