# ==============================================================================
# MindForge Java 生产环境变量模板
#
# 用法（服务器上）：
#   1. cp mindforge-java.env.example /opt/mindforge/mindforge.env
#   2. 编辑 /opt/mindforge/mindforge.env，把所有 <...> 占位填成真实值
#   3. chmod 600 /opt/mindforge/mindforge.env && chown mindforge:mindforge /opt/mindforge/mindforge.env
#
# ⚠️ 这个文件【永远不要】提交 git、不要传到任何网盘/聊天工具 —— 它就是全部家底。
# ==============================================================================

# ---------- 数据库（本机 MySQL）----------
# 建库建用户命令见 DEPLOY.md 第 3 步
MINDFORGE_DB_HOST=127.0.0.1
MINDFORGE_DB_PORT=3306
MINDFORGE_DB_NAME=mindforge
MINDFORGE_DB_USER=mindforge
MINDFORGE_DB_PASSWORD=<第3步给 mindforge 用户设的密码>

# ---------- Redis（本机，要求已设 requirepass）----------
MINDFORGE_REDIS_HOST=127.0.0.1
MINDFORGE_REDIS_PORT=6379
MINDFORGE_REDIS_PASSWORD=<第3步给 Redis 设的密码>

# ---------- JWT 签名密钥 ----------
# 生成：openssl rand -base64 32
# ⚠️ 泄露 = 任何人可伪造任意用户登录态；换密钥 = 全部用户被登出
MINDFORGE_JWT_SECRET=<openssl rand -base64 32 的输出>

# ---------- 阿里云 OSS ----------
# 与 dev 环境可共用同一个 bucket；endpoint 必须用公网地址（服务器在香港时选香港 bucket 最快）
MINDFORGE_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
MINDFORGE_OSS_BUCKET=<bucket 名>
MINDFORGE_OSS_ACCESS_KEY_ID=<RAM 子账号 AK>
MINDFORGE_OSS_ACCESS_KEY_SECRET=<RAM 子账号 SK>

# ---------- Java ↔ Python 共享令牌 ----------
# 生成：openssl rand -base64 24
# ⚠️ 必须与 Python 侧 .env 的 JAVA_SERVICE_TOKEN 完全一致（含大小写，不能有首尾空格）
# ⚠️ 不要复用 dev 的令牌
MINDFORGE_SERVICE_TOKEN=<openssl rand -base64 24 的输出>

# ---------- AI 模型配置的加密密钥（AES，Base64，解码后须 16/24/32 字节）----------
# ⚠️ 与 dev 用不同的值：生产库里管理员录入的模型 API Key 要用这把密钥加密
#    生成：openssl rand -base64 32
# ⚠️ 换密钥后库里已有密文解不开，需要重新录入 AI 配置
MINDFORGE_AI_CONFIG_SECRET_KEY=<openssl rand -base64 32 的输出>
