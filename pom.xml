<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.zest</groupId>
    <artifactId>mindforge-ai</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mindforge-ai</name>
    <description>mindforge-ai</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>

    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <jjwt>0.12.6</jjwt>
        <knife4j>4.4.0</knife4j>
        <druid>1.2.24</druid>
        <aliyun-oss.version>3.18.5</aliyun-oss.version>
        <openhtmltopdf.version>1.0.10</openhtmltopdf.version>
        <jacoco.version>0.8.12</jacoco.version>
        <spotbugs.version>4.9.3.0</spotbugs.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 参数校验：@Valid / @NotBlank，用于错误码 40001 参数校验失败 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
            邮件：邮箱验证码（注册 / 找回密码）。

            只引入 starter 不写死任何服务商 —— spring.mail.* 走标准 SMTP，
            QQ 邮箱、阿里云邮件推送、腾讯云 SES、企业邮都能用同一份代码，
            换服务商只改配置。
            ⚠️ QQ 邮箱的密码位要填【授权码】（16 位），不是登录密码，
               且需先在邮箱设置里开启 SMTP 服务。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!--
            Redis：限流计数、登录失败计数。

            选它而不是进程内缓存（Caffeine）的原因：计数要跨实例共享。
            用本地缓存的话，部署 N 个实例，限流阈值实际会变成「阈值 × N」，
            登录失败 5 次锁定也会变成 5×N 次才锁 —— 防护被稀释。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 连接池，让 Lettuce 复用连接而不是每次新建 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!--
            MyBatis-Plus 3.5.9+ 把依赖 JSqlParser 的插件（PaginationInnerInterceptor、
            BlockAttackInnerInterceptor 等）从核心包拆到了独立模块，必须显式引入。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 阿里云 OSS SDK：文件上传到对象存储，不占本机磁盘 -->
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
            <version>${aliyun-oss.version}</version>
        </dependency>

        <!--
            简历 PDF 服务端导出：XHTML -> PDF。

            选 openhtmltopdf 而不是无头 Chromium：纯 Java、无外部进程、
            单次渲染几十毫秒级内存占用，2 核 2G 的 ECS 扛得住。
            Chromium 常驻 300MB+，为了导出一份简历不值当。

            ⚠️ 它只认 CSS 2.1 子集：没有 flex / grid / column-count。
               布局只能用 table 或 float，模板里别照抄前端的 flex 写法。
            ⚠️ 它用 XML 解析器读 HTML，模板必须是良构 XHTML：
               <br> 要写 <br/>，&nbsp; 是未定义实体要写 &#160;。
        -->
        <dependency>
            <groupId>com.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-pdfbox</artifactId>
            <version>${openhtmltopdf.version}</version>
        </dependency>
        <!--
            模板引擎。只用来把结构化简历数据填进 XHTML，不用它的 MVC 视图解析
            （所有 controller 都返回 Result 对象，不走视图名，自动装配的
            ViewResolver 对我们无影响）。

            ⚠️ 模板模式必须是 XML 而不是 HTML —— HTML 模式输出的 <br> 不带斜杠，
               openhtmltopdf 会直接解析失败。配置见 application.yml 的
               spring.thymeleaf.mode。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter-test</artifactId>
            <version>${mybatis-plus.version}</version> <!-- 与主 Starter 版本保持一致 -->
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt}</version>
            <scope>runtime</scope>
        </dependency>


        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
            <version>${knife4j}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.springdoc</groupId>
                    <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- 单独引入兼容版本 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.9</version> <!-- 或 2.8.9\2.7.0 -->
        </dependency>

        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
            <version>${druid}</version> <!-- 推荐 1.2.24 或更高 -->
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                覆盖率报表：只在 verify 阶段生成报告，不设阈值。
                理由：先把「有数字」建起来，阈值等覆盖率稳定后再加，
                否则第一天就会因为一堆历史空白把构建打红。
                报告位置：target/site/jacoco/index.html
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                静态检查：threshold=Medium，只拦住 Medium/High 级别的问题。
                EI_EXPOSE_REP / EI_EXPOSE_REP2 属于「getter 返回可变对象」，本项目的
                DTO/VO/Service 大量使用这种写法，属于既有设计，统一在
                config/spotbugs-exclude.xml 里排除；另有 10 条历史问题作为基线
                也一并排除，清掉一条就从过滤文件里删一条，不要只删不过滤。
            -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <excludeFilterFile>${project.basedir}/config/spotbugs-exclude.xml</excludeFilterFile>
                    <failOnError>true</failOnError>
                    <xmlOutput>true</xmlOutput>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
